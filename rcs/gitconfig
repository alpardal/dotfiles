[user]
  name = André Luiz Pardal
  email = alpardal@gmail.com

[include]
  path = ~/.gitconfig.local

[core]
  editor = vim -f
  autocrlf = input
  pager = delta --syntax-theme='Monokai Extended'
  attributesfile = /home/andre/.gitattributes
  excludesFile = ~/dotfiles/global-gitignore

# [log]
#   date = iso

[credential]
  helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret

[commit]
  gpgSign = true
  verbose = true

[gpg]
  format = ssh

[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[fetch]
  prune = true
  pruneTags = true
  fsckobjects = true

[transfer]
  fsckobjects = true

[receive]
  fsckobjects = true

[help]
  autocorrect = prompt

[push]
  default = simple # only push if branch is already tracking a remote branch
  autoSetupRemote = true # create the remote branch, add tracking, and push
  followTags = true

[pull]
  ff = only

[column]
  ui = auto

[color]
  ui = auto
  diff = auto

[diff]
  # algorithm = patience
  algorithm = histogram
  # colorMoved = default
  colorMoved = plain
  colorMovedWS = allow-indentation-change
  renames = copies
  mnemonicPrefix = true
  interHunkContext = 10


[merge]
  ff = only
  conflictstyle = zdiff3
  tool = vimdiff

[mergetool]
  prompt = false
#
# [pager]
#   diff = diff-highlight | less
#   log = diff-highlight | less
#   show = diff-highlight | less

[interactive]
  diffFilter = delta --color-only
  singlekey = true

[status]
  showStash = true
  showUntrackedFiles = all

[rebase]
  autoSquash = true
  updateRefs = true
  missingCommitsCheck = warn

[rerere]
  enabled = true

[tag]
  sort = version:refname

[alias]
  pushf = push --force-with-lease
    # log with list of modified files in each commit:
  ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat --oneline
    # file history, with diffs:
  fl = log -u
    # files modified in last commit:
  dl = "!git ll -1"
    # find a file path in codebase:
  f = "!git ls-files | grep -i"
    # search codebase for a string:
  gr = grep -Ii
    # list all aliases:
  aliases = "!git config -l | grep alias | cut -c 7-"
    # update upstream branches and fast-forward
  up = "!git remote update -p; git merge --ff-only @{u}"
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
